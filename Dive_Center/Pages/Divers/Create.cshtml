@page
@model Dive_Center.Pages.Divers.CreateModel
@{
    ViewData["Title"] = "Добавить дайвера";
}

<h1>Добавить дайвера</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="Diver.Name" class="control-label"></label>
                <input asp-for="Diver.Name" class="form-control" />
                <span asp-validation-for="Diver.Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Diver.Email" class="control-label"></label>
                <input asp-for="Diver.Email" class="form-control" />
                <span asp-validation-for="Diver.Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Diver.DateOfBirth" class="control-label"></label>
                <input asp-for="Diver.DateOfBirth" class="form-control" />
                <span asp-validation-for="Diver.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Diver.CertificationLevel" class="control-label"></label>
                <input asp-for="Diver.CertificationLevel" class="form-control" />
                <span asp-validation-for="Diver.CertificationLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Добавить" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}