@page
@model Dive_Center.Pages.Divers.DeleteModel
@{
    ViewData["Title"] = "Удалить дайвера";
}

<h1>Удалить дайвера</h1>

<h3>Вы уверены, что хотите удалить этого дайвера?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Diver.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Diver.Name)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Diver.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Diver.Email)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Diver.DateOfBirth)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Diver.DateOfBirth)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Diver.CertificationLevel)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Diver.CertificationLevel)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Diver.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>