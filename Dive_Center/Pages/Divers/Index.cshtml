@page
@model Dive_Center.Pages.Divers.IndexModel
@{
    ViewData["Title"] = "Список дайверов";
}

<h1>Список дайверов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить дайвера</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Divers[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Divers[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Divers[0].DateOfBirth)</th>
            <th>@Html.DisplayNameFor(model => model.Divers[0].CertificationLevel)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Divers)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                <td>@Html.DisplayFor(modelItem => item.CertificationLevel)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>